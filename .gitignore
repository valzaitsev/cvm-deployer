# Ignoring:
#
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# all .tfvars files
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Do NOT ignore example override files
!example.tfvars

# CLI configuration files
.terraformrc
terraform.rc

# Python ignores
__pycache__/
*.py[cod]
*$py.class

# Ignore OS generated files
.DS_Store
Thumbs.db